{
  "name": "enjoys/docker_ws",
  "type": "utilite",
  "description": "Generate docker workspace",
  "require": {
    "php": "~8.0",
    "composer/semver": "~3.4.4",
    "symfony/console": "~6.0.19",
    "enjoys/functions": "^2.4.18",
    "symfony/yaml": "~6.0.19",
    "symfony/process": "~5.4.51",
    "enjoys/dotenv-writer": "~0.1.5"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Enjoys\\DockerWs\\": "src/"
    }
  },
  "bin": [
      "bin/docker-ws"
  ],
  "require-dev": {
    "symfony/var-dumper": "~6.0.19",
    "vimeo/psalm": "~5.26.1",
    "phpunit/phpunit": "~9.6.34"
  },
  "scripts": {
    "psalm": "@php ./vendor/bin/psalm"
  }
}
